Instance.new("UICorner", SelectPet).CornerRadius = UDim.new(0, 12)

-- Dropdown Frame
local Drop = Instance.new("ScrollingFrame")
Drop.Parent = Main
Drop.Position = UDim2.new(0.08, 0, 0, 155)
Drop.Size = UDim2.new(0.84, 0, 0, 130)
Drop.CanvasSize = UDim2.new(0,0,0,0)
Drop.ScrollBarImageTransparency = 0.3
Drop.Visible = false
Drop.BackgroundColor3 = Color3.fromRGB(30,30,30)
Drop.BorderSizePixel = 0
Instance.new("UICorner", Drop).CornerRadius = UDim.new(0, 12)

local UIList = Instance.new("UIListLayout", Drop)
UIList.Padding = UDim.new(0, 6)

-- Adopt Me Pets (HIGH → LOW TIER)
local Pets = {
	"Shadow Dragon","Bat Dragon","Giraffe","Frost Dragon",
	"Owl","Parrot","Evil Unicorn","Crow",
	"Arctic Reindeer","Albino Monkey","Turtle","Kangaroo",
	"Diamond Unicorn","Diamond Dragon",
	"Gold Unicorn","Gold Dragon",
	"Queen Bee","Phoenix","Goldhorn",
	"Unicorn","Dragon","Kitsune","Griffin"
}

local selectedPet = "None"

for _, pet in ipairs(Pets) do
	local Btn = Instance.new("TextButton")
	Btn.Parent = Drop
	Btn.Size = UDim2.new(1, -10, 0, 30)
	Btn.Text = pet
	Btn.Font = Enum.Font.Gotham
	Btn.TextSize = 13
	Btn.TextColor3 = Color3.new(1,1,1)
	Btn.BackgroundColor3 = Color3.fromRGB(55,55,55)
	Btn.BorderSizePixel = 0
	Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 8)

	Btn.MouseButton1Click:Connect(function()
		selectedPet = pet
		SelectPet.Text = pet .. "  ▼"
		Drop.Visible = false
	end)
end

UIList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
	Drop.CanvasSize = UDim2.new(0,0,0,UIList.AbsoluteContentSize.Y + 10)
end)

SelectPet.MouseButton1Click:Connect(function()
	Drop.Visible = not Drop.Visible
end)

-- Variant Buttons
local variants = {"F","R","NFR","MFR"}
local selectedVariant = "F"

local VariantFrame = Instance.new("Frame")
VariantFrame.Parent = Main
VariantFrame.Position = UDim2.new(0.08,0,0,295)
VariantFrame.Size = UDim2.new(0.84,0,0,40)
VariantFrame.BackgroundTransparency = 1

local VList = Instance.new("UIListLayout", VariantFrame)
VList.FillDirection = Enum.FillDirection.Horizontal
VList.Padding = UDim.new(0,8)
VList.HorizontalAlignment = Enum.HorizontalAlignment.Center

for _, v in ipairs(variants) do
	local B = Instance.new("TextButton")
	B.Parent = VariantFrame
	B.Size = UDim2.new(0.22,0,1,0)
	B.Text = v
	B.Font = Enum.Font.GothamBold
	B.TextSize = 14
	B.TextColor3 = Color3.new(1,1,1)
	B.BackgroundColor3 = Color3.fromRGB(70,70,70)
	Instance.new("UICorner", B).CornerRadius = UDim.new(0,10)

	B.MouseButton1Click:Connect(function()
		selectedVariant = v
		for _, x in ipairs(VariantFrame:GetChildren()) do
			if x:IsA("TextButton") then
				x.BackgroundColor3 = Color3.fromRGB(70,70,70)
			end
		end
		B.BackgroundColor3 = Color3.fromRGB(90,140,90)
	end)
end

