local layout = Instance.new("UIListLayout", drop)
layout.Padding = UDim.new(0, 6)

-- PET LIST (HIGH ➜ LOW)
local pets = {
	"Shadow Dragon","Bat Dragon","Giraffe","Frost Dragon",
	"Owl","Parrot","Evil Unicorn","Crow",
	"Arctic Reindeer","Turtle","Kangaroo",
	"Albino Monkey","Diamond Unicorn","Golden Unicorn",
	"Unicorn","Dragon","Griffin"
}

local selectedPet = "None"
local selectedType = "F"

for _, pet in ipairs(pets) do
	local btn = Instance.new("TextButton", drop)
	btn.Size = UDim2.new(1, -12, 0, 32)
	btn.Text = pet
	btn.Font = Enum.Font.Gotham
	btn.TextSize = 13
	btn.BackgroundColor3 = Color3.fromRGB(50,50,50)
	btn.TextColor3 = Color3.fromRGB(240,240,240)
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)

	btn.MouseButton1Click:Connect(function()
		selectedPet = pet
		petButton.Text = pet .. "  ▼"
		drop.Visible = false
		drop.Size = UDim2.fromScale(0.8, 0)
	end)
end

petButton.MouseButton1Click:Connect(function()
	drop.Visible = not drop.Visible
	drop.Size = drop.Visible and UDim2.fromScale(0.8, 0.45) or UDim2.fromScale(0.8, 0)
end)

-- TYPE BUTTONS
local typeFrame = Instance.new("Frame", main)
typeFrame.Position = UDim2.fromScale(0.1, 0.71)
typeFrame.Size = UDim2.fromScale(0.8, 0.12)
typeFrame.BackgroundTransparency = 1

local typeColors = {
	F = Color3.fromRGB(120,180,255),      -- light blue
	R = Color3.fromRGB(200,80,120),       -- dark pink
	NFR = Color3.fromRGB(90,200,120),     -- green
	MFR = Color3.fromRGB(170,120,255)     -- violet
}

local types = {"F","R","NFR","MFR"}
local buttons = {}

for i, t in ipairs(types) do
	local b = Instance.new("TextButton", typeFrame)
	b.Size = UDim2.fromScale(0.22, 1)
	b.Position = UDim2.fromScale((i-1)*0.26, 0)
	b.Text = t
	b.Font = Enum.Font.GothamBold
	b.TextSize = 13
	b.BackgroundColor3 = Color3.fromRGB(55,55,55)
	b.TextColor3 = Color3.new(1,1,1)
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 10)
	buttons[t] = b

	b.MouseButton1Click:Connect(function()
		selectedType = t
		for k, v in pairs(buttons) do
			v.BackgroundColor3 = Color3.fromRGB(55,55,55)
		end
		b.BackgroundColor3 = typeColors[t]
	end)
end

