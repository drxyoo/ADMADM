-- DROPDOWN LIST
local drop = Instance.new("Frame", main)
drop.Position = UDim2.fromScale(0.1, 0.57)
drop.Size = UDim2.fromScale(0.8, 0)
drop.BackgroundColor3 = Color3.fromRGB(35,35,35)
drop.Visible = false
drop.ClipsDescendants = true
Instance.new("UICorner", drop).CornerRadius = UDim.new(0, 10)

local layout = Instance.new("UIListLayout", drop)
layout.Padding = UDim.new(0, 4)

-- HIGH ➜ LOW TIER PETS (VISUAL)
local pets = {
	"Shadow Dragon","Bat Dragon","Giraffe","Frost Dragon",
	"Owl","Parrot","Evil Unicorn","Crow",
	"Arctic Reindeer","Turtle","Kangaroo",
	"Albino Monkey","Diamond Unicorn","Golden Unicorn",
	"Unicorn","Dragon","Griffin"
}

local selectedPet = "None"
local selectedType = "F"

for _,name in ipairs(pets) do
	local b = Instance.new("TextButton", drop)
	b.Size = UDim2.new(1, -10, 0, 26)
	b.Text = name
	b.Font = Enum.Font.Gotham
	b.TextSize = 12
	b.BackgroundColor3 = Color3.fromRGB(45,45,45)
	b.TextColor3 = Color3.fromRGB(230,230,230)
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)

	b.MouseButton1Click:Connect(function()
		selectedPet = name
		petButton.Text = name .. "  ▼"
		drop.Visible = false
		drop.Size = UDim2.fromScale(0.8, 0)
	end)
end

petButton.MouseButton1Click:Connect(function()
	drop.Visible = not drop.Visible
	drop.Size = drop.Visible and UDim2.fromScale(0.8, 0.45) or UDim2.fromScale(0.8, 0)
end)

-- F / R / NFR / MFR BUTTONS
local types = {"F","R","NFR","MFR"}
local typeFrame = Instance.new("Frame", main)
typeFrame.Position = UDim2.fromScale(0.1, 0.73)
typeFrame.Size = UDim2.fromScale(0.8, 0.12)
typeFrame.BackgroundTransparency = 1

for i,t in ipairs(types) do
	local b = Instance.new("TextButton", typeFrame)
	b.Size = UDim2.fromScale(0.22, 1)
	b.Position = UDim2.fromScale((i-1)*0.26, 0)
	b.Text = t
	b.Font = Enum.Font.GothamBold
	b.TextSize = 12
	b.BackgroundColor3 = Color3.fromRGB(50,50,50)
	b.TextColor3 = Color3.fromRGB(255,255,255)
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)

	b.MouseButton1Click:Connect(function()
		selectedType = t
	end)
end

