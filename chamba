local petButtons = {}
local selectedPet = "None"
local selectedType = "F"

-- CREATE PET BUTTONS
local function createPetButtons()
	for _, p in ipairs(petButtons) do
		p:Destroy()
	end
	petButtons = {}

	for _, pet in ipairs(pets) do
		local btn = Instance.new("TextButton", scroll)
		btn.Size = UDim2.new(1, -12, 0, 34)
		btn.Text = pet
		btn.Font = Enum.Font.Gotham
		btn.TextSize = 14
		btn.BackgroundColor3 = Color3.fromRGB(50,50,50)
		btn.TextColor3 = Color3.fromRGB(240,240,240)
		Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)

		btn.MouseButton1Click:Connect(function()
			selectedPet = pet
		end)

		table.insert(petButtons, btn)
	end
end

createPetButtons()

-- SEARCH FILTER
search:GetPropertyChangedSignal("Text"):Connect(function()
	local text = search.Text:lower()
	for _, btn in ipairs(petButtons) do
		btn.Visible = btn.Text:lower():find(text) ~= nil
	end
end)

-- TYPE BUTTONS
local typeFrame = Instance.new("Frame", main)
typeFrame.Position = UDim2.fromScale(0.08, 0.68)
typeFrame.Size = UDim2.fromScale(0.84, 0.08)
typeFrame.BackgroundTransparency = 1

local typeColors = {
	F = Color3.fromRGB(120,180,255),
	R = Color3.fromRGB(200,80,120),
	NFR = Color3.fromRGB(90,200,120),
	MFR = Color3.fromRGB(170,120,255)
}

local buttons = {}
local types = {"F","R","NFR","MFR"}

for i, t in ipairs(types) do
	local b = Instance.new("TextButton", typeFrame)
	b.Size = UDim2.fromScale(0.22, 1)
	b.Position = UDim2.fromScale((i-1)*0.26, 0)
	b.Text = t
	b.Font = Enum.Font.GothamBold
	b.TextSize = 14
	b.BackgroundColor3 = Color3.fromRGB(55,55,55)
	b.TextColor3 = Color3.new(1,1,1)
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 10)
	buttons[t] = b

	b.MouseButton1Click:Connect(function()
		selectedType = t
		for _, v in pairs(buttons) do
			v.BackgroundColor3 = Color3.fromRGB(55,55,55)
		end
		b.BackgroundColor3 = typeColors[t]
	end)
end

