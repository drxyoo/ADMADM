local UIList = Instance.new("UIListLayout", Drop)
UIList.Padding = UDim.new(0, 6)

local Pets = {
	"Shadow Dragon","Bat Dragon","Giraffe","Frost Dragon",
	"Owl","Parrot","Evil Unicorn","Crow",
	"Arctic Reindeer","Albino Monkey","Turtle","Kangaroo",
	"Diamond Unicorn","Diamond Dragon",
	"Gold Unicorn","Gold Dragon",
	"Queen Bee","Phoenix","Goldhorn",
	"Unicorn","Dragon","Kitsune","Griffin"
}

local selectedPet = "None"

for _, pet in ipairs(Pets) do
	local Btn = Instance.new("TextButton")
	Btn.Parent = Drop
	Btn.Size = UDim2.new(1, -10, 0, 28)
	Btn.Text = pet
	Btn.Font = Enum.Font.Gotham
	Btn.TextSize = 13
	Btn.TextColor3 = Color3.new(1,1,1)
	Btn.BackgroundColor3 = Color3.fromRGB(50,50,50)
	Btn.BorderSizePixel = 0
	Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 8)

	Btn.MouseButton1Click:Connect(function()
		selectedPet = pet
		SelectPet.Text = pet .. "  ▼"
		Drop.Visible = false
	end)
end

UIList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
	Drop.CanvasSize = UDim2.new(0,0,0,UIList.AbsoluteContentSize.Y + 8)
end)

SelectPet.MouseButton1Click:Connect(function()
	Drop.Visible = not Drop.Visible
end)

